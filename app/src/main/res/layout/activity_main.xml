<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.budiyev.android.codescanner.CodeScannerView
        android:id="@+id/scanner_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:autoFocusButtonColor="@android:color/white"
        app:autoFocusButtonPaddingVertical="50dp"
        app:autoFocusButtonVisible="true"
        app:flashButtonColor="@android:color/white"
        app:flashButtonPaddingVertical="50dp"
        app:flashButtonVisible="true"
        app:frameAspectRatioHeight="1"
        app:frameAspectRatioWidth="1"
        app:frameColor="@android:color/holo_purple"
        app:frameCornersRadius="60dp"
        app:frameCornersSize="40dp"
        app:frameSize="0.75"
        app:frameThickness="5dp"
        app:frameVerticalBias="0.5"
        app:maskColor="#77000000">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:min="1"
            android:paddingVertical="30dp" />

    </com.budiyev.android.codescanner.CodeScannerView>

</FrameLayout>